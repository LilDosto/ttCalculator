<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyName>ttCalculator</AssemblyName>
    <Product>ttCalculator - Gelişmiş Matematik &amp; Nümerik Analiz Stüdyosu</Product>
    <Version>2.1.0</Version>
    <Company>ttCalculator</Company>
    <DefaultItemExcludes>$(DefaultItemExcludes);MathApp.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
